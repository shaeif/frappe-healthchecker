# Copy to .env and change every password before the first `docker compose up`.
# .env is git-ignored. Never commit real passwords.

COMPOSE_PROJECT_NAME=amc-tracker

# Site name = the Host header nginx routes to. Use your real FQDN in production
# (e.g. amc.example.com). For a local test "amc.localhost" works out of the box.
SITE_NAME=amc.localhost

# Absolute base URL used in email / Teams links (no trailing slash). Its hostname must be
# SITE_NAME: the browser must use the same hostname, or real-time pop-ups fail ("Invalid origin").
HOST_NAME=http://amc.localhost:8080

# Host port the site is published on
HTTP_PORT=8080

# MariaDB root password (also used by create-site to create the site database)
DB_ROOT_PASSWORD=change-me-db-root-password

# Password of the Frappe "Administrator" user
ADMIN_PASSWORD=change-me-admin-password

# Container OS time zone (log timestamps). Frappe itself uses System Settings = Asia/Qatar.
TZ=Asia/Qatar

# Base image for the custom build. Pin a release for production, e.g. v16.50.0
BASE_IMAGE=frappe/erpnext
BASE_TAG=v16

# Name/tag of the image built from ./Dockerfile
CUSTOM_IMAGE=amc-tracker
CUSTOM_TAG=latest
